{
  "name": "rps-politika",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "test": "npm run test -w server",
    "lint": "npm run lint -w client",
    "sfx": "tools/build-sfx.sh",
    "sfx:sources": "tools/fetch-sfx-sources.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "~5.7.2"
  }
}
